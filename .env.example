# Copy this file to  .env  (same folder as index.html) and fill in your values. The server reads it when it starts.
# Never share your .env file (the web server refuses to send it).

# ---- EMAIL: how the 6-digit OTP code reaches the player -------------------------------------------
# EASIEST = a Gmail account that sends the codes:
#   1. Google Account -> Security -> turn on 2-Step Verification
#   2. Google Account -> Security -> App passwords -> create one called "Ashen Roads" (16 letters)
#   3. put the gmail address and the 16-letter app password here (NOT your normal Gmail password)
SMTP_USER=yourgame@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# Other mail providers (Outlook, Brevo ...): also set SMTP_HOST (and SMTP_PORT, 465 = TLS, 587 = STARTTLS)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# EMAIL_FROM=Ashen Roads <yourgame@gmail.com>

# Or use Resend instead of SMTP:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Ashen Roads <noreply@your-verified-domain.com>

# If NO email is set up, the code is printed in the black server window (only you can read it) - fine for testing alone.
# OTP_CONSOLE=0   <- uncomment to forbid that and show an error instead

# ---- DATABASE ---------------------------------------------------------------------------------------
# Accounts are saved in the  database/  folder (users.json + players.csv).  Free hosts (Render...) erase it on every restart:
# for live hosting use the free Upstash database instead:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# ---- optional ----
# ADMIN_USERNAME=YourAccountName      <- remove the # and put YOUR account name; then log in with it and press the ADMIN link (several admins: name1,name2)
